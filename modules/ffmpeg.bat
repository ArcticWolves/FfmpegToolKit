@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul

:: ============================================================
:: modules\ffmpeg.bat
::
:: Модуль работы с FFmpeg.
:: Предоставляет пользователю три основных сценария:
::   1. Редактирование
::   2. Извлечение
::   3. Конвертация
::
:: Архитектурная роль: Controller для операций обработки мультимедиа.
:: ============================================================

:: ------------------------------------------------------------
:: Проверка загрузки config.bat
:: ------------------------------------------------------------
if not defined CONFIG_LOADED (
    echo.
    echo [ERROR] Конфигурация не загружена.
    echo [ERROR] Сначала вызовите FfmpegToolKit.bat
    echo.
    pause
    exit /b 1
)

:MAIN_MENU
cls

echo ============================================================
echo                         FFmpeg
echo ============================================================
echo.
echo Исполняемый файл:
echo %FFMPEG%
echo.
echo ============================================================
echo.
echo  1. Редактировать
echo  2. Извлечь
echo  3. Конвертировать
echo  4. Пакетная конвертация
echo.
echo  0. Назад
echo.
echo ============================================================
echo.

set "CHOICE="
set /p "CHOICE=Выберите действие: "

if "%CHOICE%"=="1" goto MENU_EDIT
if "%CHOICE%"=="2" goto MENU_EXTRACT
if "%CHOICE%"=="3" goto MENU_CONVERT
if "%CHOICE%"=="4" goto MENU_BATCH
if "%CHOICE%"=="0" goto EXIT_MODULE

echo.
echo [ERROR] Некорректный выбор.
echo.
pause
goto MAIN_MENU


:: ============================================================
:: Редактирование
:: ============================================================
:MENU_EDIT
call :RunModule "edit.bat"
goto MAIN_MENU


:: ============================================================
:: Извлечение
:: ============================================================
:MENU_EXTRACT
call :RunModule "extract.bat"
goto MAIN_MENU


:: ============================================================
:: Конвертация
:: ============================================================
:MENU_CONVERT
call :RunModule "convert.bat"
goto MAIN_MENU


:: ============================================================
:: Пакетная конвертация
:: ============================================================
:MENU_BATCH
call :RunModule "batch.bat"
goto MAIN_MENU


:: ============================================================
:: Универсальный запуск дочернего модуля
::
:: Поиск выполняется в каталоге modules.
:: Например:
::   modules\edit.bat
::   modules\extract.bat
::   modules\convert.bat
:: ============================================================
:RunModule
set "MODULE_PATH=%MODULES_DIR%\%~1"

if not exist "%MODULE_PATH%" (
    echo.
    echo [ERROR] Не найден модуль:
    echo         %MODULE_PATH%
    echo.
    pause
    exit /b 1
)

call "%MODULE_PATH%"
exit /b 0


:: ============================================================
:: Выход из модуля
:: ============================================================
:EXIT_MODULE
endlocal
exit /b 0
